
# Map public car browsing endpoints to backend public route
/api/cars/*   https://ridebazzar.up.railway.app/api/public/cars/:splat   200
/api/cars   https://ridebazzar.up.railway.app/api/public/cars   200

# Proxy API requests to the Railway backend (general)
/api/*   https://ridebazzar.up.railway.app/:splat   200

# Proxy uploads to the Railway backend (for uploaded images)
/uploads/*   https://ridebazzar.up.railway.app/:splat   200

# Fallback: serve index for SPA routes
/*    /index.html   200
# Redirect root to home.html
/    /home.html   200
